---
import { nav, site } from "../data/site";
import { url } from "../lib/base";
import Logo from "./Logo.astro";
interface Props {
  bookingHref?: string;
}
const { bookingHref = "/#termin" } = Astro.props;
const path = Astro.url.pathname;
const home = url("/");
---

<header class="header">
  <div class="wrap header-inner">
    <a class="brand" href={home} aria-current={path === home ? "page" : undefined}>
      <Logo />
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
      <span data-nav-label>Menu</span>
    </button>
    <div class="header-tools">
      <a class="header-phone" href={site.phoneHref}>Zavolať {site.phone}</a>
      <a class="btn header-cta" href={bookingHref}>Poslať nezáväzný dopyt</a>
    </div>
    <nav id="site-nav" class="nav-panel" aria-label="Hlavné" hidden>
      {nav.map((item) => (
        <a href={url(item.href)} aria-current={path === url(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a class="nav-only-mobile" href={url("/catering/")}>Catering</a>
      <a class="nav-only-mobile" href={site.phoneHref}>Zavolať {site.phone}</a>
      <a class="btn nav-only-mobile" href={bookingHref}>Poslať nezáväzný dopyt</a>
    </nav>
  </div>
</header>
<button class="nav-backdrop" type="button" data-nav-backdrop hidden aria-label="Zavrieť menu"></button>
