---
import Base from "../layouts/Base.astro";
import Logos from "../components/Logos.astro";
import { gridColumns, isPublicQuote, quotes } from "../data/site";
const visible = quotes.filter(isPublicQuote);

const description = "Referencie hostí sály Kinekus v Žiline: svadby, konferencia IPA Slovakia, firemný večierok METRO a ďalšie akcie.";
---

<Base title="Referencie | Sála Kinekus Žilina" description={description}>
  <article class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Referencie klientov</p>
        <h1>Referencie klientov.</h1>
        <p class="lead">Skúsenosti hostí, ktorí v sále mali svadbu, konferenciu alebo firemnú akciu.</p>
      </div>
      <div class="quote-grid" style={`--cols: ${gridColumns(visible.length)}`}>
        {visible.map((quote) => (
          <blockquote class="quote">
            <p>„{quote.text}“</p>
            <footer>
              <cite>{quote.name}</cite>
              <small>{quote.meta}</small>
            </footer>
          </blockquote>
        ))}
      </div>
      <h2 style="margin:2.5rem 0 1rem;font-size:2rem">Klienti sály</h2>
      <Logos />
      <p style="margin-top:1.5rem"><a class="btn btn-dark" href="/#termin">Overiť voľný termín</a></p>
    </div>
  </article>
</Base>
