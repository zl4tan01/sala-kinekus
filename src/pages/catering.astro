---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Booking from "../components/Booking.astro";
import Pricing from "../components/Pricing.astro";
import media from "../data/media.json";

const description = "Catering v sále Kinekus v Žiline nezabezpečujeme vlastnou kuchyňou. Odporučíme overené firmy, ktoré pripravia ponuku na mieru a často aj výzdobu.";
---

<Base title="Catering | Sála Kinekus Žilina" description={description} bookingHref="#termin">
  <article>
    <header class="sub-hero">
      <div class="wrap">
        <p class="eyebrow">Catering</p>
        <h1>Jedlo pripraví catering, ktorý si vyberiete.</h1>
        <p class="lead" style="margin-top:1rem">
          Vlastnú kuchyňu v sále nemáme. Odporúčania cateringových partnerov vám pošleme s ponukou. Viacerí vedia zabezpečiť aj výzdobu.
        </p>
      </div>
    </header>
    <div class="section">
      <div class="wrap path-grid">
        <div class="prose">
          <p>Jedlo, obsluhu a výzdobu riešite s dodávateľom, ktorého si vyberiete. Ak dodávateľa nemáte, odporúčania cateringových partnerov vám pošleme s ponukou.</p>
          <p>Ak už máte vlastný catering, radi vám povieme, ako sa u nás zariadi zázemie a časovanie.</p>
        </div>
        <div class="frame">
          <Picture image={media.party} sizes="(min-width: 720px) 46vw, 100vw" priority />
        </div>
      </div>
    </div>
  </article>
  <Pricing id="catering" />
  <Booking title="Overiť voľný termín" />
</Base>
