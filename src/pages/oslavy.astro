---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Booking from "../components/Booking.astro";
import media from "../data/media.json";

const description = "Rodinné oslavy v sále Kinekus v Žiline: narodeniny, jubileá a krstiny. Flexibilné usporiadanie, balkón a terasa, parkovanie pred budovou. Nezáväzne overte termín.";
const photo = media.gallery.find((item) => item.id === "svadba-25");
if (!photo) throw new Error("Chýba fotografia svadba-25");
---

<Base title="Oslavy Žilina | Sála Kinekus" description={description} bookingHref="#termin">
  <article>
    <header class="sub-hero">
      <div class="wrap">
        <p class="eyebrow">Oslavy</p>
        <h1>Narodeniny, jubileum aj krstiny v jednej sále.</h1>
        <p class="lead" style="margin-top:1rem">
          Rodinná oslava tu nemusí kopírova svadbu ani konferenciu. Stoly, parket a pódium poskladáme podľa počtu hostí, programu a rozpočtu.
        </p>
        <div class="hero-actions">
          <a class="btn btn-dark" href="#termin">Overiť termín oslavy</a>
        </div>
      </div>
    </header>
    <div class="section">
      <div class="wrap">
        <div class="frame" style="margin-bottom:1.5rem">
          <Picture image={photo} sizes="(min-width: 980px) 74rem, 100vw" priority />
        </div>
        <div class="fact-grid">
          <article class="fact">
            <h3>Usporiadanie</h3>
            <p>Stoly na hostinu, rady na príhovor alebo voľný parket, keď sa tancuje. Presné počty miest povieme pri obhliadke — závisia od výzdoby, pódia a cateringu.</p>
          </article>
          <article class="fact">
            <h3>Pódium a vonku</h3>
            <p>Pódium 12×6 m na kapelu, DJ-a alebo krátky program. Z sály sa prechádza priamo na balkón a terasu.</p>
          </article>
          <article class="fact">
            <h3>Príprava a jedlo</h3>
            <p>Od dopytu po večer máte koho sa opýtať. Catering a výzdobu odporučíme, vlastnú kuchyňu v sále neprevádzkujeme. Rozsah doladíme podľa rozpočtu.</p>
          </article>
          <article class="fact">
            <h3>Hostia a prístup</h3>
            <p>Kapacita priestoru je 50 až 250 osôb. Sála je na Rosinskej ceste 13, parkovanie je priamo pred budovou.</p>
          </article>
        </div>
        <div class="prose" style="margin-top:1.5rem">
          <p>Svetelné scény sa dajú nastaviť podľa nálady večera. Ozvučenie má mixážny pult Yamaha, náhlavné aj ručné mikrofóny a reproduktory.</p>
          <p>Cenník na webe nie je. Cenu povieme podľa typu oslavy, termínu a toho, čo z techniky využijete. Termín v kalendári je voľný na dopyt. Rezerváciu potvrdíme až my, po dohode.</p>
        </div>
      </div>
    </div>
  </article>
  <Booking segment="b2c" kind="oslava" title="Termín oslavy" />
</Base>
