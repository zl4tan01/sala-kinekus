---
import Base from "../layouts/Base.astro";
import Booking from "../components/Booking.astro";
import Location from "../components/Location.astro";
import { site } from "../data/site";
import { url } from "../lib/base";

const description = "Kontakt na Sálu Kinekus, Rosinská cesta 13, Žilina. Veľké parkovisko zadarmo v areáli, balkón a terasa priamo zo sály. +421 908 761 253.";
---

<Base title="Kontakt | Sála Kinekus Žilina" description={description} bookingHref="#termin">
  <header class="sub-hero">
    <div class="wrap">
      <p class="eyebrow">Kontakt</p>
      <h1>Napíšte alebo zavolajte.</h1>
      <p class="lead" style="margin-top:1rem">
        {site.legalName} Administratíva je {site.hours}. Ozveme sa vám. V areáli je veľké parkovisko zadarmo a zo sály sa vychádza priamo na balkón a terasu.
      </p>
      <p style="margin-top:1rem">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="contact-secondary"><a href={site.landlineHref}>{site.landline}</a></p>
      <p style="margin-top:0.8rem">
        <a href={site.instagram}>Instagram</a> · <a href={site.facebook}>Facebook</a> · <a href={url("/#prehliadka")}>Virtuálna prehliadka</a>
      </p>
    </div>
  </header>
  <Booking />
  <Location />
</Base>
