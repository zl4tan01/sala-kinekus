---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Booking from "../components/Booking.astro";
import media from "../data/media.json";

const description = "Konferenčná miestnosť v Žiline pre školenia, prezentácie a firemné akcie. Full HD projektor 5400 lm, SMART zatemnenie, ozvučenie Yamaha a parkovanie pred budovou.";
---

<Base title="Konferenčná miestnosť Žilina | Sála Kinekus" description={description} bookingHref="#termin">
  <article>
    <header class="sub-hero">
      <div class="wrap">
        <p class="eyebrow">Konferencie a školenia</p>
        <h1>Konferenčná miestnosť v Žiline, pripravená na projekciu.</h1>
        <p class="lead" style="margin-top:1rem">
          Firemná akcia tu nerieši, či bude vidieť na plátno a kde hostia zaparkujú. Projektor, zatemnenie, zvuk aj parkovanie pred budovou sú súčasťou sály.
        </p>
        <div class="hero-actions">
          <a class="btn btn-dark" href="#termin">Overiť voľný termín</a>
        </div>
      </div>
    </header>
    <div class="section">
      <div class="wrap">
        <div class="frame" style="margin-bottom:1.5rem">
          <Picture image={media.b2b} sizes="(min-width: 980px) 74rem, 100vw" priority />
        </div>
        <div class="fact-grid">
          <article class="fact">
            <h3>Projekcia</h3>
            <p>V sále je profesionálny Full HD projektor so svietivosťou 5 400 lumenov.</p>
          </article>
          <article class="fact">
            <h3>SMART zatemnenie</h3>
            <p>Okná sa dajú zatieniť a sálu pripraviť na projekciu. Svetelné scény nastavíte podľa programu.</p>
          </article>
          <article class="fact">
            <h3>Ozvučenie</h3>
            <p>Mixážny pult Yamaha, náhlavné aj ručné mikrofóny a sústava reproduktorov.</p>
          </article>
        </div>
        <div class="prose" style="margin-top:1.5rem">
          <p>Sála sa hodí na konferenciu, školenie, prezentáciu aj firemnú akciu. Rozloženie divadlo alebo škola pripravíme podľa toho, či hostia počúvajú, alebo si píšu.</p>
          <p>Kapacita priestoru je 50 až 250 osôb. Koľko miest dá konkrétne usporiadanie, vám povieme podľa programu — na webe to číslo nemáme.</p>
          <p>Sála je na Rosinskej ceste, na okraji Žiliny, s parkovaním priamo pred budovou.</p>
        </div>
      </div>
    </div>
  </article>
  <Booking segment="b2b" kind="konferencia" title="Termín pre firemnú akciu" />
</Base>
