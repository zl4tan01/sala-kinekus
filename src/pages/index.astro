---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Booking from "../components/Booking.astro";
import Gallery from "../components/Gallery.astro";
import Location from "../components/Location.astro";
import Logos from "../components/Logos.astro";
import media from "../data/media.json";
import { faqs, layouts, proof, quotes, site, steps } from "../data/site";

const description = "Svadobná sála v Žiline na svadby, stužkové, narodeniny, jubileá, krstiny a plesy. Parket, pódium 12×6 m, balkón a parkovanie pre hostí. Aj konferencie a školenia.";
const featured = quotes.filter((quote) => quote.featured);
const byId = (id: string) => {
  const image = media.gallery.find((item) => item.id === id);
  if (!image) throw new Error(`Chýba fotografia ${id}`);
  return image;
};
const oslavaPhoto = byId("svadba-25");
const cateringPhoto = byId("svadba-22");
---

<Base
  title="Sála Kinekus Žilina | Svadby, stužkové a oslavy"
  description={description}
  bookingHref="#termin"
>
  <section class="hero">
    <Picture image={media.b2c} sizes="100vw" priority />
    <div class="hero-shade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">Sála Kinekus · Rosinská cesta, Žilina</p>
      <h1>Svadba, stužková aj rodinná oslava v jednej sále.</h1>
      <p class="lead">
        Narodeniny, jubileum, krstiny aj ples. Rozloženie, svetlo a program nastavíme podľa vás a podľa rozpočtu. Veľký parket, pódium 12×6 m, balkón a parkovanie pre hostí sú súčasťou priestoru. Od prvého dopytu po večer máte koho sa opýtať.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#termin">Overiť termín oslavy</a>
        <a class="btn-line" href={site.tour} target="_blank" rel="noopener noreferrer">Virtuálna prehliadka</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="proof" aria-label="V skratke">
      {proof.map((item) => (
        <article>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </article>
      ))}
    </section>
  </div>

  <section class="section" id="oslavy">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Súkromné oslavy</p>
        <h2>Svadba, stužková, rodinná oslava aj ples.</h2>
        <p class="lead">
          Sála sa prispôsobí tomu, čo chystáte. Rozloženie, rozpočet aj prípravu riešime s vami. Parket, pódium, balkón a parkovanie pre hostí sú už v priestore.
        </p>
      </div>
      <div class="path-grid">
        <article class="path">
          <Picture image={media.b2c} sizes="(min-width: 720px) 46vw, 100vw" />
          <div class="path-body">
            <p class="eyebrow">Svadby</p>
            <h3>Svadba, na ktorú sa zmestí rodina</h3>
            <p>Veľký parket a pódium 12×6 m pre kapelu alebo DJ-a. Svetlo nastavíme podľa večera, nie podľa jednej šablóny.</p>
            <ul>
              <li>Flexibilita usporiadania: hostina pri stoloch, tanec na parkete</li>
              <li>Individuálny prístup podľa rozpočtu, cenu povieme na mieru</li>
              <li>Pomoc s prípravou od obhliadky po deň svadby</li>
              <li>Catering a výzdobu odporučíme, vyberiete si vy</li>
            </ul>
            <a class="btn btn-dark" href="/svadby/">Svadobná sála</a>
          </div>
        </article>
        <article class="path">
          <Picture image={media.stuzkova} sizes="(min-width: 720px) 46vw, 100vw" />
          <div class="path-body">
            <p class="eyebrow">Stužkové</p>
            <h3>Stužková s pódiom a voľným parketom</h3>
            <p>Program, tanec aj väčšia trieda. Pódium unesie kapelu aj DJ-a a hostia zaparkujú pred budovou.</p>
            <ul>
              <li>Stoly na večeru a parket na zábavu, podľa priebehu večera</li>
              <li>Ozvučenie s mixážnym pultom Yamaha, náhlavné aj ručné mikrofóny</li>
              <li>Parkovanie pre hostí priamo pred budovou na Rosinskej ceste</li>
              <li>Pre stužkové sála uvádza 100–300 hostí</li>
            </ul>
            <a class="btn btn-dark" href="/stuzkova/">Stužková v sále</a>
          </div>
        </article>
        <article class="path">
          <Picture image={oslavaPhoto} sizes="(min-width: 720px) 46vw, 100vw" />
          <div class="path-body">
            <p class="eyebrow">Oslavy</p>
            <h3>Narodeniny, jubileum aj krstiny</h3>
            <p>Rodinný stôl, krátky príhovor alebo večer vonku. Sálu poskladáme podľa počtu hostí a toho, čo oslavujete.</p>
            <ul>
              <li>Flexibilita usporiadania podľa veľkosti rodiny</li>
              <li>Balkón a terasa priamo zo sály</li>
              <li>Pomoc s prípravou a rozsah podľa vášho rozpočtu</li>
              <li>Catering odporučíme, vlastnú kuchyňu v sále neprevádzkujeme</li>
            </ul>
            <a class="btn btn-dark" href="/oslavy/">Rodinné oslavy</a>
          </div>
        </article>
        <article class="path">
          <Picture image={media.wide} sizes="(min-width: 720px) 46vw, 100vw" />
          <div class="path-body">
            <p class="eyebrow">Plesy</p>
            <h3>Ples s parketom a pódiom</h3>
            <p>Keď má večer tanečný parket a miesto pre kapelu. Svetelné scény sa dajú prepínať podľa programu.</p>
            <ul>
              <li>Veľký parket a pódium 12×6 m</li>
              <li>Balkón a terasa, keď si hostia potrebujú oddýchnuť</li>
              <li>Parkovanie pre hostí pred budovou</li>
              <li>Od prvého dopytu po večer máte koho sa opýtať</li>
            </ul>
            <a class="btn btn-dark" href="#termin">Overiť termín plesu</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="aj-pre-firmy" style="padding-top:0">
    <div class="wrap">
      <article class="firms">
        <Picture image={media.b2b} sizes="(min-width: 720px) 34vw, 100vw" />
        <div class="firms-body">
          <p class="eyebrow">Aj pre firmy</p>
          <h2>Konferencie, školenia a firemné akcie.</h2>
          <p>
            Sála slúži aj firmám. V priestore je Full HD projektor so svietivosťou 5&nbsp;400 lumenov, SMART zatemnenie okien a ozvučenie. Hostia zaparkujú pred budovou.
          </p>
          <p><a class="btn" href="/konferencie/">Konferenčná sála</a></p>
        </div>
      </article>
    </div>
  </section>

  <section class="section" id="priebeh" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Ako to prebieha</p>
        <h2>Od dopytu po večer, s niekým na druhej strane.</h2>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <b>{step.n}</b>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="rozlozenie" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Rozloženie</p>
        <h2>Sála nie je jedna pevná schéma.</h2>
        <p class="lead">
          Stoly a parket preskladáme podľa toho, či hostia sedia, počúvajú alebo tancujú. Presné počty miest pri jednotlivých usporiadaniach vám povieme pri obhliadke — závisia od výzdoby, pódia a chodu cateringu.
        </p>
      </div>
      <div class="layout-grid">
        {layouts.map((item) => (
          <article class="layout-card">
            <svg class="viz" viewBox="0 0 160 96" aria-hidden="true">
              <rect x="18" y="8" width="124" height="16" rx="3" fill="#c6a36b"></rect>
              {item.id === "divadlo" && [0, 1, 2, 3].map((row) => (
                [0, 1, 2, 3, 4, 5, 6].map((col) => (
                  <circle cx={28 + col * 18} cy={40 + row * 14} r="3" fill="#1b1612"></circle>
                ))
              ))}
              {item.id === "skola" && [0, 1, 2].map((row) => (
                <g>
                  <rect x="24" y={40 + row * 16} width="112" height="5" rx="1" fill="#1b1612"></rect>
                  {[0, 1, 2, 3, 4, 5].map((col) => (
                    <rect x={30 + col * 18} y={47 + row * 16} width="8" height="4" fill="#7a5424"></rect>
                  ))}
                </g>
              ))}
              {item.id === "banket" && [0, 1].map((row) => (
                [0, 1, 2].map((col) => (
                  <g>
                    <circle cx={40 + col * 40} cy={46 + row * 28} r="10" fill="none" stroke="#1b1612" stroke-width="2"></circle>
                  </g>
                ))
              ))}
              {item.id === "party" && (
                <g>
                  <rect x="36" y="42" width="88" height="36" rx="4" fill="none" stroke="#1b1612" stroke-width="2"></rect>
                  <text x="80" y="64" text-anchor="middle" font-size="11" fill="#1b1612">parket</text>
                </g>
              )}
            </svg>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="priestor" style="padding-top:0">
    <div class="wrap">
      <div class="frame" style="margin-bottom:1.5rem">
        <Picture image={media.wide} sizes="(min-width: 980px) 74rem, 100vw" />
      </div>
      <div class="section-head">
        <p class="eyebrow">Priestor</p>
        <h2>Postavená pri rozširovaní Kinekusu. Nová, vrátane zázemia.</h2>
        <p class="lead">
          Spoločenská sála vznikla pri rozširovaní distribučného centra spoločnosti Kinekus v Žiline. Priestory sú novo postavené, vrátane sociálnych zariadení, a navrhnuté tak, aby sa dali prispôsobiť rôznym udalostiam. Veľké pódium a akustika umožňujú aj koncert.
        </p>
      </div>
      <div class="fact-grid">
        <article class="fact">
          <h3>Kapacita</h3>
          <p>50 až 250 osôb. Pre svadby a stužkové materiály sály uvádzajú 100 až 300 hostí.</p>
        </article>
        <article class="fact">
          <h3>Pódium a parket</h3>
          <p>Pódium 12×6 m a veľký tanečný parket. Akustika sály zvládne aj koncert.</p>
        </article>
        <article class="fact">
          <h3>Svetlo a obraz</h3>
          <p>SMART systém zastrie okná na projekciu a vie navoliť svetelné scény.</p>
        </article>
        <article class="fact">
          <h3>Zvuk</h3>
          <p>Mixážny pult Yamaha, náhlavné aj ručné mikrofóny, výkonné reproduktory.</p>
        </article>
        <article class="fact">
          <h3>Vonku</h3>
          <p>Z sály sa prechádza priamo na balkón a terasu.</p>
        </article>
        <article class="fact">
          <h3>Prístup</h3>
          <p>Okraj Žiliny, Rosinská cesta, parkovanie priamo pred budovou.</p>
        </article>
      </div>
    </div>
  </section>

  <Gallery
    ids={["svadba-01", "stuz-01", "svadba-22", "stuz-06", "svadba-11", "svadba-25"]}
    filters={false}
    heading="Svadby, stužkové a slávnostné stoly"
    lead="Výber z osláv, ktoré sa v sále už konali. Celú galériu, vrátane firemných akcií, nájdete na samostatnej stránke."
  />
  <div class="wrap" style="margin-top:-3rem;margin-bottom:2rem">
    <a class="btn-line" href="/galeria/" style="color:var(--ink)">Celá galéria</a>
  </div>

  <section class="section" id="referencie">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Referencie</p>
        <h2>Čo o sále povedali hostia.</h2>
        <p class="lead">Vyberáme z referencií, ktoré sála zverejnila. Celé znenie je na stránke referencií.</p>
      </div>
      <div class="quote-grid">
        {featured.map((quote) => (
          <blockquote class="quote">
            <p>„{quote.text.length > 280 ? `${quote.text.slice(0, 280).trim()}…` : quote.text}“</p>
            <footer>
              <cite>{quote.name}</cite>
              <small>{quote.meta}</small>
            </footer>
          </blockquote>
        ))}
      </div>
      <p style="margin-top:1.2rem"><a href="/referencie/">Všetky referencie</a></p>
      <div style="margin-top:2rem">
        <h3 style="font-size:1.6rem;margin-bottom:0.8rem">Klienti sály</h3>
        <Logos />
      </div>
    </div>
  </section>

  <section class="section" id="catering" style="padding-top:0">
    <div class="wrap path-grid">
      <div>
        <p class="eyebrow">Catering</p>
        <h2>Jedlo a výzdobu vieme odporučiť.</h2>
        <div class="prose" style="margin-top:1rem">
          <p>Vlastnú kuchyňu v sále neprevádzkujeme. Odporučíme overené cateringové firmy, ktoré pripravia ponuku na mieru. Viaceré vedia zabezpečiť aj výzdobu.</p>
          <p>Výber zostáva na vás. Ak už máte vlastného dodávateľa, radi vám povieme, ako to pri vašej akcii vieme zariadiť.</p>
        </div>
        <p style="margin-top:1rem"><a class="btn btn-dark" href="/catering/">Viac o cateringu</a></p>
      </div>
      <div class="frame">
        <Picture image={cateringPhoto} sizes="(min-width: 720px) 46vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section" id="otazky" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Otázky</p>
        <h2>Skôr, než sa spýtate.</h2>
      </div>
      <div class="faq">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Booking
    segment="b2c"
    title="Overte termín oslavy"
    lead="Označte voľný deň svadby, stužkovej, narodenín, jubilea, krstín alebo plesu. Kliknutie deň nerezervuje. Pošlete nezáväzný dopyt a termín potvrdíme my."
  />
  <Location />
</Base>
