---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Booking from "../components/Booking.astro";
import AdviceCards from "../components/AdviceCards.astro";
import Gallery from "../components/Gallery.astro";
import Location from "../components/Location.astro";
import Logos from "../components/Logos.astro";
import Tour from "../components/Tour.astro";
import media from "../data/media.json";
import { allAdvice, featuredAdvice } from "../lib/advice";
import { faqs, gridColumns, isPublicQuote, layouts, proof, quotes, site, steps } from "../data/site";

const description = "Svadobná sála a stužkové v Žiline. Parket, pódium 12×6 m, balkón a parkovanie pred budovou. Aj konferencie a firemné akcie.";
const featured = quotes.filter((quote) => quote.featured && isPublicQuote(quote));
const photo = (id: string) => {
  const found = media.gallery.find((item) => item.id === id);
  if (!found) throw new Error(`Chýba fotografia ${id}`);
  return found;
};
function excerpt(text: string, max = 280): string {
  const clean = text.replace(/\s+/g, " ").trim();
  if (clean.length <= max) return clean;
  const slice = clean.slice(0, max + 1);
  let end = -1;
  const marks = /[.!?](?=\s)/g;
  for (const match of slice.matchAll(marks)) {
    const at = match.index ?? -1;
    if (at < 80) continue;
    const before = slice.slice(Math.max(0, at - 2), at);
    if (/(^|\s)p$/i.test(before)) continue;
    end = at;
  }
  if (end >= 80) return slice.slice(0, end + 1).trim();
  return clean;
}
const cateringPhoto = media.gallery.find((item) => item.id === "svadba-22");
if (!cateringPhoto) throw new Error("Chýba fotografia svadba-22");
const advicePreview = featuredAdvice(await allAdvice());
---

<Base
  title="Sála Kinekus Žilina | Svadby a stužkové"
  description={description}
  bookingHref="#termin"
>
  <section class="hero">
    <Picture image={media.hero} sizes="100vw" priority />
    <div class="hero-shade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">Sála Kinekus · Rosinská cesta, Žilina</p>
      <h1>Svadba aj stužková v sále, ktorá sa prispôsobí vám.</h1>
      <p class="lead">
        Veľký parket a pódium 12×6 m, balkón s terasou a parkovanie pred budovou na Rosinskej ceste sú súčasťou priestoru. Svetlo a ozvučenie sú v sále.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#termin">Overiť voľný termín</a>
        <a class="btn-line" href="#prehliadka">Virtuálna prehliadka</a>
      </div>
      <figure class="hero-quote" data-hero-quote hidden>
        <blockquote data-hero-quote-text></blockquote>
        <figcaption>
          <span data-hero-quote-by></span>
        </figcaption>
        <a class="hero-proof" href={site.maps} rel="noopener noreferrer">Recenzie na Google</a>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <section class="proof" aria-label="V skratke">
      {proof.map((item) => (
        <article>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </article>
      ))}
    </section>
  </div>

  <div id="program">
  <section class="section" id="svadby-a-stuzkove">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Svadby a stužkové</p>
        <h2>Svadba aj stužková, každá podľa svojho programu.</h2>
        <p class="lead">
          Veľký parket, pódium 12×6 m a ozvučenie sú v priestore. Rozloženie pripravíme podľa programu.
        </p>
      </div>
      <div class="path-grid">
        <article class="path">
          <Picture image={photo("svadba-23")} sizes="(min-width: 720px) 46vw, 100vw" />
          <div class="path-body">
            <p class="eyebrow">Svadby</p>
            <h3>Svadba s parketom a pódiom</h3>
            <p>Veľký parket a pódium 12×6 m pre sprievodný program, kapelu alebo DJ-a. Ozvučenie je v sále, svetlo sa dá nastaviť podľa večera.</p>
            <ul>
              <li>Usadenie podľa stolov a programu</li>
              <li>Mixážny pult Yamaha, náhlavné aj ručné mikrofóny</li>
              <li>Balkón a terasa priamo zo sály, parkovanie pred budovou</li>
              <li>Catering a výzdobu odporučíme, vyberiete si vy</li>
            </ul>
            <a class="btn btn-dark" href="/svadby/">Svadobná sála</a>
          </div>
        </article>
        <article class="path">
          <Picture image={photo("stuz-03")} sizes="(min-width: 720px) 46vw, 100vw" />
          <div class="path-body">
            <p class="eyebrow">Stužkové</p>
            <h3>Stužková podľa vašich predstáv</h3>
            <p>Pre študentov, rodičov aj triednych. Program a tanec sa zmestia na parket a pódium. Pred akciou si s tímom sály prejdete priebeh večera.</p>
            <ul>
              <li>Detaily večera si viete prejsť s tímom sály vopred</li>
              <li>Rozloženie sály prispôsobíme vašej akcii</li>
              <li>Pódium 12×6 m, ozvučenie Yamaha, parkovanie pred budovou</li>
              <li>Kapacita 50 až 250 osôb</li>
            </ul>
            <a class="btn btn-dark" href="/stuzkova/">Stužková v sále</a>
          </div>
        </article>
      </div>
      <p class="aside-line">
        <strong>Plesy.</strong> Sála je vhodná aj na ples: parket a pódium 12×6 m sú v priestore. Termín overíte rovnakým dopytom a do správy napíšete, že ide o ples.
      </p>
    </div>
  </section>

  <section class="section" id="pre-firmy" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pre firmy</p>
        <h2>Konferencie, školenia, prezentácie a firemné akcie.</h2>
        <p class="lead">
          Aj pre firmy. Keď potrebujete projekciu, zvuk a miesto, kde hostia zaparkujú.
        </p>
      </div>
      <article class="path path-wide">
        <Picture image={photo("konf-03")} sizes="(min-width: 720px) 48vw, 100vw" />
        <div class="path-body">
          <h3>Sála pripravená na firemný program</h3>
          <p>Konferencia, školenie, prezentácia aj firemná akcia pre vlastných ľudí. Technika je v priestore, rozloženie prispôsobíme programu.</p>
          <ul>
            <li>Full HD projektor so svietivosťou 5 400 lumenov</li>
            <li>SMART osvetlenie a možnosť zastrieť okná</li>
            <li>Ozvučenie s mixážnym pultom Yamaha, náhlavné a ručné mikrofóny</li>
            <li>Parkovanie pred budovou</li>
          </ul>
          <a class="btn btn-dark" href="/konferencie/">Pre firmy</a>
        </div>
      </article>
    </div>
  </section>
  </div>

  <Tour />

  <section class="section" id="priebeh" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Ako to prebieha</p>
        <h2>Od dopytu po večer, s niekým na druhej strane.</h2>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <b>{step.n}</b>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="viewing">
        <a class="btn btn-dark" href="#termin" data-viewing>Obhliadka sály</a>
        <p class="note">Dohodneme termín, kedy si sálu prejdete naživo.</p>
      </div>
    </div>
  </section>

  <section class="section" id="rozlozenie" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Rozloženie</p>
        <h2>Sála nie je jedna pevná schéma.</h2>
        <p class="lead">
          Rozloženie sály prispôsobíme vašej akcii. Presné počty miest pri jednotlivých usporiadaniach závisia od výzdoby, pódia a chodu cateringu. Na obhliadke ich prejdete.
        </p>
      </div>
      <div class="layout-grid">
        {layouts.map((item) => (
          <article class="layout-card">
            <svg class="viz" viewBox="0 0 160 96" aria-hidden="true">
              <rect x="18" y="8" width="124" height="16" rx="3" fill="#c6a36b"></rect>
              {item.id === "divadlo" && [0, 1, 2, 3].map((row) => (
                [0, 1, 2, 3, 4, 5, 6].map((col) => (
                  <circle cx={28 + col * 18} cy={40 + row * 14} r="3" fill="#1b1612"></circle>
                ))
              ))}
              {item.id === "skola" && [0, 1, 2].map((row) => (
                <g>
                  <rect x="24" y={40 + row * 16} width="112" height="5" rx="1" fill="#1b1612"></rect>
                  {[0, 1, 2, 3, 4, 5].map((col) => (
                    <rect x={30 + col * 18} y={47 + row * 16} width="8" height="4" fill="#7a5424"></rect>
                  ))}
                </g>
              ))}
              {item.id === "banket" && [0, 1].map((row) => (
                [0, 1, 2].map((col) => (
                  <g>
                    <circle cx={40 + col * 40} cy={46 + row * 28} r="10" fill="none" stroke="#1b1612" stroke-width="2"></circle>
                  </g>
                ))
              ))}
              {item.id === "party" && (
                <g>
                  <rect x="36" y="42" width="88" height="36" rx="4" fill="none" stroke="#1b1612" stroke-width="2"></rect>
                  <text x="80" y="64" text-anchor="middle" font-size="11" fill="#1b1612">parket</text>
                </g>
              )}
            </svg>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="priestor" style="padding-top:0">
    <div class="wrap">
      <div class="frame" style="margin-bottom:1.5rem">
        <Picture image={media.wide} sizes="(min-width: 980px) 74rem, 100vw" />
      </div>
      <div class="section-head">
        <p class="eyebrow">Priestor</p>
        <h2>Postavená pri rozširovaní Kinekusu. Nová, vrátane zázemia.</h2>
        <p class="lead">
          Spoločenská sála vznikla pri rozširovaní distribučného centra spoločnosti Kinekus v Žiline. Priestory sú novo postavené, vrátane sociálnych zariadení. Sála je vhodná pre stužkové, plesy, koncerty, večierky, školenia, firemné akcie, svadby, spoločenské stretnutia a mnoho ďalších akcií. Veľké pódium a akustika umožňujú aj koncert.
        </p>
      </div>
      <div class="fact-grid">
        <article class="fact">
          <h3>Usadenie</h3>
          <p>Koľko miest dá konkrétne usporiadanie, povieme podľa stolov, pódia a cateringu.</p>
        </article>
        <article class="fact">
          <h3>Pódium a parket</h3>
          <p>Pódium 12×6 m a veľký tanečný parket. Akustika sály zvládne aj koncert.</p>
        </article>
        <article class="fact">
          <h3>Svetlo a obraz</h3>
          <p>SMART systém zastrie okná na projekciu a vie navoliť svetelné scény.</p>
        </article>
        <article class="fact">
          <h3>Zvuk</h3>
          <p>Mixážny pult Yamaha, náhlavné aj ručné mikrofóny, výkonné reproduktory.</p>
        </article>
        <article class="fact">
          <h3>Vonku</h3>
          <p>Z sály sa prechádza priamo na balkón a terasu.</p>
        </article>
        <article class="fact">
          <h3>Prístup</h3>
          <p>Okraj Žiliny, Rosinská cesta, parkovanie priamo pred budovou.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="rady" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Rady</p>
        <h2>Než si vyberiete sálu a deň.</h2>
        <p class="lead">Tri praktické texty k obhliadke, termínu a stužkovej. Ďalšie rady sú na samostatnej stránke.</p>
      </div>
      <AdviceCards articles={advicePreview} />
      <p class="advice-more"><a class="btn-line" href="/rady/">Všetky rady</a></p>
    </div>
  </section>

  <Gallery
    ids={["svadba-01", "stuz-01", "svadba-22", "stuz-06", "svadba-11", "svadba-25"]}
    filters={false}
    heading="Svadby, stužkové a slávnostné stoly"
    lead="Výber zo svadieb a stužkových, ktoré sa v sále už konali. Celú galériu, vrátane firemných akcií, nájdete na samostatnej stránke."
  />
  <div class="wrap" style="margin-top:-3rem;margin-bottom:2rem">
    <a class="btn-line" href="/galeria/" style="color:var(--ink)">Celá galéria</a>
  </div>

  <section class="section" id="recenzie-google" data-reviews hidden>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Google</p>
        <h2>Z recenzií na Google</h2>
        <p class="lead">Z profilu Sála Žilina. Stužkové sú na svojej stránke.</p>
      </div>
      <ul class="theme-grid" data-review-themes></ul>
      <div class="review-grid" data-review-list></div>
      <div class="reviews-actions">
        <a class="btn btn-dark" href={site.writeReview} data-write-review rel="noopener noreferrer">Napísať recenziu</a>
      </div>
      <p class="note"><a href={site.maps} rel="noopener noreferrer">Recenzie z Google profilu Sála Žilina</a></p>
    </div>
  </section>

  <section class="section" id="referencie">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Referencie klientov</p>
        <h2>Referencie klientov.</h2>
        <p class="lead">Skúsenosti hostí. Celé znenie je na stránke referencií.</p>
      </div>
      <div class="quote-grid" style={`--cols: ${gridColumns(featured.length)}`}>
        {featured.map((quote) => (
          <blockquote class="quote">
            <p>„{excerpt(quote.text)}“</p>
            <footer>
              <cite>{quote.name}</cite>
              <small>{quote.meta}</small>
            </footer>
          </blockquote>
        ))}
      </div>
      <p style="margin-top:1.2rem"><a href="/referencie/">Všetky referencie</a></p>
      <div style="margin-top:2rem">
        <h3 style="font-size:1.6rem;margin-bottom:0.8rem">Klienti sály</h3>
        <Logos />
      </div>
    </div>
  </section>

  <section class="section" id="catering" style="padding-top:0">
    <div class="wrap path-grid">
      <div>
        <p class="eyebrow">Catering</p>
        <h2>Jedlo a výzdobu vieme odporučiť.</h2>
        <div class="prose" style="margin-top:1rem">
          <p>Vlastnú kuchyňu neprevádzkujeme. Odporučíme kvalitné cateringové firmy, ktoré pripravia ponuku na mieru. Viaceré vedia zabezpečiť aj výzdobu.</p>
          <p>Výber zostáva na vás. Ak už máte vlastného dodávateľa, radi vám povieme, ako to pri vašej akcii vieme zariadiť.</p>
        </div>
        <p style="margin-top:1rem"><a class="btn btn-dark" href="/catering/">Viac o cateringu</a></p>
      </div>
      <div class="frame">
        <Picture image={cateringPhoto} sizes="(min-width: 720px) 46vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section" id="otazky" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Otázky</p>
        <h2>Skôr, než sa spýtate.</h2>
      </div>
      <div class="faq">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Booking kind="svadba" title="Overte voľný termín" />
  <Location />
</Base>
